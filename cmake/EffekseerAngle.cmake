# Pinned 1.80.7's Windows GL loader assumes WGL even for its GLES3 renderer.
# Adapt a private build-tree copy, never the shared/downloaded source checkout.
function(astra_effekseer_write_changed path content)
    if(EXISTS "${path}")
        file(READ "${path}" previous)
        if(previous STREQUAL content)
            return()
        endif()
    endif()
    file(WRITE "${path}" "${content}")
endfunction()

function(astra_effekseer_angle source_dir binary_dir)
    set(original "${source_dir}/Dev/Cpp/EffekseerRendererGL")
    set(adapted "${binary_dir}/astra-angle/EffekseerRendererGL")
    if(NOT EXISTS "${adapted}/CMakeLists.txt")
        file(COPY "${original}" DESTINATION "${binary_dir}/astra-angle")
    endif()
    set(base "${adapted}/EffekseerRendererGL")
    foreach(header EffekseerRendererGL.Base.Pre.h EffekseerRendererGL.Base.h EffekseerRendererGL.GLExtension.h)
        file(READ "${original}/EffekseerRendererGL/${header}" content)
        if(NOT header STREQUAL "EffekseerRendererGL.GLExtension.h")
            string(REPLACE "#if _WIN32" "#if _WIN32 && !defined(__EFFEKSEER_RENDERER_GLES3__)" content "${content}")
        endif()
        string(REPLACE "#define GL_GLEXT_PROTOTYPES" "#ifndef GL_GLEXT_PROTOTYPES\n#define GL_GLEXT_PROTOTYPES\n#endif" content "${content}")
        string(REGEX REPLACE "#define (GL_[A-Z0-9_]+) ([^\r\n]+)" "#ifndef \\1\n#define \\1 \\2\n#endif" content "${content}")
        astra_effekseer_write_changed("${base}/${header}" "${content}")
    endforeach()
    set(loader "${base}/EffekseerRendererGL.GLExtension.cpp")
    file(READ "${original}/EffekseerRendererGL/EffekseerRendererGL.GLExtension.cpp" content)
    if(NOT content MATCHES "wglGetProcAddress" OR NOT content MATCHES "GET_PROC_REQ\\(glMapBuffer\\)")
        message(FATAL_ERROR "Effekseer ANGLE adaptation no longer matches the pinned loader")
    endif()
    string(REPLACE "wglGetProcAddress" "eglGetProcAddress" content "${content}")
    # glMapBuffer is not ES3 core; the renderer already supports MapBufferRange.
    string(REPLACE "GET_PROC_REQ(glMapBuffer);" "GET_PROC(glMapBuffer);" content "${content}")
    astra_effekseer_write_changed("${loader}" "#include <EGL/egl.h>\n${content}")
    get_target_property(sources EffekseerRendererGL SOURCES)
    string(REPLACE "${original}/" "${adapted}/" sources "${sources}")
    set_property(TARGET EffekseerRendererGL PROPERTY SOURCES "${sources}")
    target_include_directories(EffekseerRendererGL BEFORE PUBLIC "$<BUILD_INTERFACE:${adapted}>")
    target_compile_definitions(EffekseerRendererGL PUBLIC __EFFEKSEER_RENDERER_GLES3__ GL_APICALL= EGLAPI=)
    if(ASTRA_EFFEKSEER_ANGLE_INCLUDE_DIR)
        target_include_directories(EffekseerRendererGL PUBLIC "${ASTRA_EFFEKSEER_ANGLE_INCLUDE_DIR}")
    endif()
    set(ASTRA_EFFEKSEER_GL_INSTALL_SOURCE "${adapted}" PARENT_SCOPE)
endfunction()
