option(ASTRA_EFFEKSEER "Enable the experimental Windows GL/ANGLE Effekseer runtime" OFF)
set(ASTRA_EFFEKSEER_ENABLED OFF)
if(ASTRA_EFFEKSEER)
    if(NOT FRAMEWORK_GRAPHICS OR WASM OR ANDROID OR (OPENGLES AND NOT OPENGLES STREQUAL "2.0") OR NOT WIN32)
        message(WARNING "Effekseer experimental requires Windows OpenGL or ANGLE ES3; keeping vanilla rendering")
    else()
        if(OPENGLES)
            set(ASTRA_EFFEKSEER_BACKEND ANGLE CACHE STRING "Effekseer backend" FORCE)
            set(ASTRA_EFFEKSEER_ANGLE_INCLUDE_DIR "${ASTRA_ANGLE_INCLUDE_DIR}")
        else()
            set(ASTRA_EFFEKSEER_BACKEND OpenGL CACHE STRING "Effekseer backend" FORCE)
        endif()
        include(${CMAKE_CURRENT_LIST_DIR}/FetchEffekseer.cmake)
        list(APPEND client_SOURCES ${CMAKE_CURRENT_SOURCE_DIR}/src/client/effekseersystem.cpp)
        list(APPEND framework_LIBRARIES Effekseer EffekseerRendererCommon EffekseerRendererGL)
        add_definitions(-DFW_EFFEKSEER)
        set(ASTRA_EFFEKSEER_ENABLED ON)
    endif()
endif()
