AstraPreyProgressBar < UIWidget
  height: 22
  @onSetup: PreyCompat.setupProgressBar(self)

AstraPreyWindow < UIWindow
  anchors.centerIn: parent
  font: verdana-11px-antialised
  size: 200 200
  color: #909090
  text-offset: -2 1
  image-source: /modules/game_prey/images/ui/popupwindow
  image-border: 4
  image-border-top: 17
  padding-top: 17
  padding-left: 4
  padding-right: 4
  padding-bottom: 4

AstraPreyButton < UIButton
  font: cipsoftFont
  color: #dfdfdf
  size: 43 20
  text-offset: 0 2
  image-source: /modules/game_prey/images/ui/buttons
  image-clip: 0 0 43 20
  image-border: 1
  padding: 10
  $hover !disabled:
    image-clip: 0 0 43 20
  $pressed:
    image-clip: 0 20 43 20
    text-offset: 1 1
  $on:
    image-clip: 0 20 43 20
    text-offset: 1 1
  $checked:
    image-clip: 0 20 43 20
    text-offset: 1 1
  $disabled:
    color: #dfdfdf88
    opacity: 0.8

AstraPreyFlatPanel < Panel
  image-source: /modules/game_prey/images/ui/panel_flat
  image-border: 1
