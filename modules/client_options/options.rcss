/* Use the client's original Cip-style PNGs without stretching their corners.
   Explicit retro paths keep the same chrome in every desktop layout. */
@spritesheet options-window {
  src: /layouts/retro/images/ui/window.png;
  window-frame: 0px 0px 236px 207px;
  window-center: 4px 17px 228px 186px;
}
@spritesheet options-button {
  src: /layouts/retro/images/ui/button.png;
  button-up: 0px 0px 22px 23px;
  button-up-center: 3px 3px 16px 17px;
  button-down: 0px 46px 22px 23px;
  button-down-center: 3px 49px 16px 17px;
}
@spritesheet options-check {
  src: /layouts/retro/images/ui/checkbox.png;
  unchecked: 0px 0px 12px 12px;
  checked: 0px 12px 12px 12px;
}
@spritesheet options-slider {
  src: /images/ui/scrollbar.png;
  slider-thumb: 0px 26px 13px 13px;
  slider-thumb-inner: 2px 28px 9px 9px;
  slider-track: 0px 65px 52px 13px;
  slider-track-inner: 1px 66px 50px 11px;
  arrow-left: 0px 39px 13px 13px;
  arrow-right: 0px 52px 13px 13px;
  arrow-up: 0px 0px 13px 13px;
  arrow-down: 0px 13px 13px 13px;
  vertical-track: 39px 0px 13px 65px;
  vertical-track-inner: 40px 1px 11px 63px;
}
body { width: 100%; height: 100%; margin: 0; color: #bfbfbf; font-family: LatoLatin; font-size: 11dp; font-weight: bold; }
div, header, footer, nav, main, h1, h2, p { display: block; }
button, select, input { font-family: LatoLatin; font-size: 11dp; color: #bfbfbf; }
.options-window { position: relative; width: 100%; height: 100%; box-sizing: border-box; padding: 0 16dp 16dp; display: flex; flex-direction: column; decorator: ninepatch(window-frame, window-center, 1); }
header { position: relative; flex: 0 0 25dp; text-align: center; font-weight: bold; line-height: 17dp; color: #afafaf; cursor: move; }
#close-options { position: absolute; right: -5dp; top: 1dp; width: 18dp; height: 17dp; line-height: 15dp; padding: 0; color: #b9b9b9; }
#close-options:hover { color: #fff; }
.options-body { display: flex; flex: 1; min-height: 0; gap: 10dp; }
#options-tabs { flex: 0 0 96dp; box-sizing: border-box; border: 1dp #242424; border-top-color: #757575; border-left-color: #757575; padding: 8dp 4dp 4dp; overflow-y: auto; }
.category { display: flex; flex-direction: column; align-items: center; justify-content: center; box-sizing: border-box; width: 100%; height: 58dp; padding: 3dp 0; color: #afafaf; }
.category img { width: 32dp; height: 32dp; margin-bottom: 3dp; }
.category span { font-weight: bold; }
.category:hover { color: #fff; background-color: #ffffff0b; }
.category.selected { color: #8cd4ff; }
main { display: flex; flex: 1; flex-direction: column; min-width: 0; min-height: 0; }
h1 { display: none; }
#options-content { flex: 1; min-height: 0; overflow-y: auto; overflow-x: hidden; padding: 3dp 0 3dp; }
.check-row { display: flex; align-items: center; min-height: 18dp; cursor: pointer; }
.check-row span { flex: 1; margin-left: 7dp; }
input[type=checkbox] { flex: 0 0 12dp; width: 12dp; height: 12dp; decorator: image(unchecked); }
input[type=checkbox]:checked { decorator: image(checked); }
input:disabled, select:disabled { opacity: 0.45; }
.range-row { margin-top: 10dp; }
.range-row label { display: block; margin-bottom: 3dp; }
.range-row span { color: #bfbfbf; }
input[type=range] { display: block; width: 100%; height: 16dp; margin-bottom: 2dp; }
input[type=range] slidertrack { height: 13dp; margin: 1dp 0; decorator: ninepatch(slider-track, slider-track-inner, 1); }
input[type=range] sliderbar { width: 13dp; height: 13dp; decorator: ninepatch(slider-thumb, slider-thumb-inner, 1); }
input[type=range] sliderarrowdec { width: 13dp; height: 13dp; decorator: image(arrow-left); }
input[type=range] sliderarrowinc { width: 13dp; height: 13dp; decorator: image(arrow-right); }
.select-row { margin: 10dp 0; }
.select-row label { display: block; margin-bottom: 5dp; }
select { display: block; width: 100%; height: 23dp; box-sizing: border-box; padding-left: 5dp; background-color: #303030; border: 1dp #7c7c7c; border-right-color: #222; border-bottom-color: #222; }
select selectvalue { display: block; line-height: 21dp; }
select selectarrow { width: 20dp; height: 21dp; decorator: image(arrow-down contain); }
select selectbox { background-color: #333; border: 1dp #888; max-height: 190dp; overflow-y: auto; }
select option { display: block; padding: 5dp 7dp; }
select option:hover, select option:checked { color: #fff; background-color: #595959; }
.hint { margin: 13dp 0 5dp; font-size: 12dp; line-height: 18dp; color: #b4b4b4; }
.device-info { margin-bottom: 8dp; padding-bottom: 8dp; border-bottom: 1dp #757575; font-size: 12dp; color: #bdbdbd; }
.device-info b { color: #e0e0e0; }.device-info p { margin: 3dp 0 0; }
footer { flex: 0 0 26dp; display: flex; align-items: flex-end; justify-content: flex-end; }
.classic-button { display: inline-block; box-sizing: border-box; min-width: 64dp; height: 20dp; padding: 0 10dp; line-height: 18dp; text-align: center; decorator: ninepatch(button-up, button-up-center, 1); }
.classic-button:hover { color: #fff; }.classic-button:active { decorator: ninepatch(button-down, button-down-center, 1); }
.language-button { margin-top: 10dp; min-width: 150dp; }
scrollbarvertical { width: 13dp; decorator: ninepatch(vertical-track, vertical-track-inner, 1); }
scrollbarvertical slidertrack { width: 13dp; }
scrollbarvertical sliderbar { width: 13dp; min-height: 20dp; decorator: ninepatch(slider-thumb, slider-thumb-inner, 1); }
scrollbarvertical sliderarrowdec { width: 13dp; height: 13dp; decorator: image(arrow-up); }
scrollbarvertical sliderarrowinc { width: 13dp; height: 13dp; decorator: image(arrow-down); }
.modal-shade { position: absolute; left: 0; top: 0; width: 100%; height: 100%; background-color: #000000a0; display: flex; align-items: center; justify-content: center; }
[hidden] { display: none; }
.language-window { width: 350dp; max-width: 90%; padding: 20dp 15dp 15dp; decorator: ninepatch(window-frame, window-center, 1); }
.language-window h2 { margin: 0 0 15dp; font-size: 15dp; text-align: center; }
.dialog-actions { display: flex; justify-content: flex-end; gap: 8dp; margin-top: 20dp; }
@media (max-width: 420dp) {
  #options-tabs { flex-basis: 80dp; padding: 3dp; }.category { height: 60dp; font-size: 12dp; }
  .category img { width: 26dp; height: 26dp; }.options-body { gap: 6dp; }
  body, input, select, button { font-size: 12dp; }
}
