<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Copy to Effekseer.local.props to opt in when building from Visual Studio. -->
  <PropertyGroup Condition="'$(Platform)'=='x64' and ('$(Configuration)'=='DirectX' or '$(Configuration)'=='OpenGL')">
    <AstraEffekseerEnabled Condition="'$(AstraEffekseerEnabled)'==''">true</AstraEffekseerEnabled>
  </PropertyGroup>
</Project>
