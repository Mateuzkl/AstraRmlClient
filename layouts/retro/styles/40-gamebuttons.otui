GameButtonsWindow < HeadlessMiniWindow
  height: 30
  &forceOpen: true
  &autoOpen: 4

  MiniWindowContents
    anchors.right: parent.right
    margin: 3
    
    Panel
      id: buttons
      anchors.fill: parent
      layout:
        type: grid
        cell-spacing: 2
        cell-size: 24 24
        flow: true
